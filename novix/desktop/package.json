{
  "name": "novix",
  "version": "1.0.0",
  "description": "Novix local AI assistant",
  "author": "Novix",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.novix.app",
    "productName": "Novix",

    "directories": {
      "output": "release"
    },

    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],

    "extraResources": [
      {
        "from": "../dist/novix-backend",
        "to": "backend"
      },
      {
        "from": "../.local_data/models/active_model.gguf",
        "to": "model/active_model.gguf"
      },
      {
        "from": "../.local_data/db.sqlite3",
        "to": "database/db.sqlite3"
      }
    ],

    "win": {
      "target": "nsis"
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}